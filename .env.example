# Direct email delivery is restricted to production.
APP_ENV=production

# Database connection.
APP_DB_HOST=127.0.0.1
APP_DB_NAME=breax_invoicing
APP_DB_USER=
APP_DB_PASSWORD=

# Public application URL used in invoice emails and public invoice links.
APP_BASE_URL=https://invoicing.example.com
# Public base URL or {code} template used to load currency flag SVGs.
PUBLIC_FLAG_BASE_URL=https://flags.example.com/
FX_STALE_AFTER_HOURS=24
SUPPORT_EMAIL=billing@example.com
LOGO_URL=https://invoicing.example.com/assets/images/logo.png
KES_FLAG_URL=https://example.com/assets/images/kes.png
USD_FLAG_URL=https://example.com/assets/images/usd.png
EUR_FLAG_URL=https://example.com/assets/images/eur.png
GBP_FLAG_URL=https://example.com/assets/images/gbp.png

# Headless Chromium for server-generated invoice email PDFs; leave blank to auto-detect Edge/Chrome.
INVOICE_PDF_BROWSER=
INVOICE_PDF_NODE=node

# SMTP settings (Gmail defaults). Use a Google app password, not your account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
MAIL_CC=
MAIL_MAX_PER_DAY=400
MAIL_MODE=live
MAIL_TEST_ADDRESS=

# Admin overdue alerts are opt-in per admin in My profile. Defaults: one alert per invoice.
ADMIN_OVERDUE_ALERT_TIME=09:00
ADMIN_OVERDUE_REPEAT_DAYS=0
ADMIN_OVERDUE_MAX_ALERTS=3
OVERDUE_CHECK_TOKEN=

# Renewal reminder scheduler. Keep the system scheduler's daily trigger at this local hour.
RENEWAL_REMINDER_TIMEZONE=Africa/Nairobi
RENEWAL_REMINDER_HOUR=8
RENEWAL_REMINDER_STAGES=30,7
RENEWAL_REMINDER_EXPIRED_DAYS=90

# Schedule `system/admin_overdue_reports.php --send` for day 1 each month using the hosting provider's PHP CLI.
# Use `php system/admin_overdue_reports.php --preview` to generate all-record reports without sending email.
# `system/domain_expiry_report.php --send --resend-today` explicitly bypasses the per-day duplicate guard.
# Schedule `system/send_renewal_reminders.php` daily at RENEWAL_REMINDER_HOUR in RENEWAL_REMINDER_TIMEZONE.

# Microsoft 365: MAIL_HOST=smtp.office365.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
# Zoho: MAIL_HOST=smtp.zoho.com, MAIL_PORT=465, MAIL_ENCRYPTION=ssl
# SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587, MAIL_ENCRYPTION=tls, MAIL_USERNAME=apikey, MAIL_PASSWORD=(the SendGrid API key)
# Mailgun: MAIL_HOST=smtp.mailgun.org, MAIL_PORT=587, MAIL_ENCRYPTION=tls
