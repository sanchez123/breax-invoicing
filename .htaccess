Options -Indexes -MultiViews
RewriteEngine On
RewriteRule ^(?:includes|database|vendor|bin|node_modules|\.idea)(?:/|$) - [F,L,NC]
RewriteRule ^logs(?:/|$) - [F,L,NC]
RewriteRule ^(?:README\.md|Invoice\.md|breax-invoice-design-brief\.md|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]
<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.env\.example$">
    Require all denied
</FilesMatch>
SetEnvIf Request_URI ".*/i/[A-Za-z0-9_-]{43}$" no_log_public_invoice
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteRule ^(.+)\.php$ /%1 [R=301,L,NE]
RewriteRule ^i/([A-Za-z0-9_-]{43})$ public_invoice.php?token=$1 [L]
RewriteRule ^i(?:/.*)?$ public_invoice.php?token= [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
